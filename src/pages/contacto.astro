---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto" description="Contacta con la redacción de AgentesIA Lab.">
  <div class="max-w-2xl mx-auto bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
    <h1 class="text-3xl font-extrabold text-slate-900 mb-2">Contacto</h1>
    <p class="text-slate-600 text-sm mb-6">
      ¿Tienes alguna consulta técnica, propuesta de colaboración o nota de prensa? Escríbenos mediante el formulario o directamente a{' '}
      <a href="mailto:contacto.labagentes@gmail.com" class="font-semibold text-indigo-600 hover:underline">
        contacto.labagentes@gmail.com
      </a>.
    </p>
    
    <form id="contacto-form" name="contacto" method="POST" data-netlify="true" class="space-y-4">
      <input type="hidden" name="form-name" value="contacto" />
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Nombre</label>
        <input type="text" name="nombre" required class="w-full px-4 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-indigo-500" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Correo electrónico</label>
        <input type="email" name="email" required class="w-full px-4 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-indigo-500" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Mensaje</label>
        <textarea name="mensaje" rows="4" required class="w-full px-4 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-indigo-500"></textarea>
      </div>
      <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm rounded-lg transition-colors cursor-pointer">
        Enviar mensaje
      </button>
    </form>

    <p id="contacto-msg" class="hidden mt-4 p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium">
      ¡Mensaje enviado correctamente! Te responderemos lo antes posible.
    </p>
  </div>

  <script>
    const contactForm = document.getElementById('contacto-form') as HTMLFormElement | null;
    const contactMsg = document.getElementById('contacto-msg');

    contactForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(contactForm);
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData as any).toString(),
      });
      contactForm.reset();
      contactMsg?.classList.remove('hidden');
    });
  </script>
</Layout>