---
interface Props {
  slotName?: string;
  format?: 'horizontal' | 'rectangle';
}

const { slotName = 'Anuncio', format = 'horizontal' } = Astro.props;
const heightClass = format === 'horizontal' ? 'min-h-[90px]' : 'min-h-[250px]';
---

<aside aria-label="Publicidad" class={`my-8 w-full flex flex-col items-center justify-center bg-slate-100 dark:bg-slate-800/50 border border-dashed border-slate-300 dark:border-slate-700 rounded-lg p-4 ${heightClass}`}>
  <span class="text-[10px] uppercase tracking-widest text-slate-400 mb-2">Publicidad · {slotName}</span>
  <!-- AQUÍ PEGARÁS EL CÓDIGO <ins class="adsbygoogle"> DE GOOGLE ADSENSE -->
  <div class="text-xs text-slate-400 text-center">Espacio reservado para bloque de anuncios ({format})</div>
</aside>