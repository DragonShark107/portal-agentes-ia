---
import { ADSENSE_ACTIVO, ADSENSE_CLIENT } from '../config/adsense';

interface Props {
  slotName?: string;
  format?: 'horizontal' | 'rectangle';
  /** ID del bloque de anuncios creado en AdSense (data-ad-slot). Opcional si usas anuncios automáticos. */
  adSlotId?: string;
}

const { slotName = 'Anuncio', format = 'horizontal', adSlotId } = Astro.props;
const heightClass = format === 'horizontal' ? 'min-h-[90px]' : 'min-h-[250px]';
const mostrar = ADSENSE_ACTIVO && ADSENSE_CLIENT && adSlotId;
---

{mostrar && (
  <aside aria-label="Publicidad" class={`my-8 w-full flex flex-col items-center justify-center ${heightClass}`}>
    <span class="text-[10px] uppercase tracking-widest text-slate-400 mb-2">Publicidad · {slotName}</span>
    <ins
      class="adsbygoogle"
      style="display:block;width:100%"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={adSlotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
