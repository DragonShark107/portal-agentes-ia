---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { ADSENSE_CLIENT, GOOGLE_SITE_VERIFICATION, BING_SITE_VERIFICATION } from '../config/adsense';

interface Props {
  title: string;
  description?: string;
  image?: string;
  publishDate?: string;
  isArticle?: boolean;
}

const {
  title,
  description = 'Noticias, análisis técnico y guías sobre Agentes de IA Autónomos, modelos locales (SLMs) y automatización.',
  image = '/og-default.png',
  publishDate,
  isArticle = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const schemaData = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: title,
      description: description,
      image: [new URL(image, Astro.site).toString()],
      datePublished: publishDate,
      dateModified: publishDate,
      author: [{ '@type': 'Organization', name: 'AgentesIA Lab', url: Astro.site }],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'AgentesIA Lab',
      url: Astro.site,
    };
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | AgentesIA Lab</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    {BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}
  

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Datos Estructurados SEO (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Google AdSense (se activa al configurar ADSENSE_PUB_ID en src/config/adsense.ts) -->
    {ADSENSE_CLIENT && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased flex flex-col min-h-screen">
    <!-- Cabecera -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-slate-200">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-extrabold text-xl tracking-tight text-slate-900">
          <span class="px-2 py-0.5 bg-indigo-600 text-white rounded text-sm">IA</span>
          <span>Agentes<span class="text-indigo-600">Lab</span></span>
        </a>

        <!-- Menú escritorio (intacto en ordenador) -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-indigo-600 transition-colors">Noticias</a>
          <a href="/sobre-nosotros" class="hover:text-indigo-600 transition-colors">Sobre nosotros</a>
          <a href="/contacto" class="hover:text-indigo-600 transition-colors">Contacto</a>
        </nav>

        <!-- Botón hamburguesa (solo móvil) -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          class="md:hidden p-2 rounded-lg text-slate-600 hover:text-indigo-600 hover:bg-slate-100 transition-colors cursor-pointer"
        >
          <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Desplegable móvil -->
      <nav id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-2 text-sm font-medium text-slate-700 shadow-sm">
        <a href="/" class="block py-2 px-3 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition-colors">Noticias</a>
        <a href="/sobre-nosotros" class="block py-2 px-3 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition-colors">Sobre nosotros</a>
        <a href="/contacto" class="block py-2 px-3 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition-colors">Contacto</a>
      </nav>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow max-w-5xl w-full mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Pie de página (Enlaces obligatorios para AdSense y RGPD) -->
    <footer class="bg-slate-900 text-slate-400 text-sm mt-16 border-t border-slate-800">
      <div class="max-w-5xl mx-auto px-4 py-10 flex flex-col md:flex-row justify-between items-center gap-4">
        <p>© {new Date().getFullYear()} AgentesIA Lab. Todos los derechos reservados.</p>
        <div class="flex flex-wrap gap-5 text-xs">
          <a href="/legal/aviso-legal" class="hover:text-white">Aviso Legal</a>
          <a href="/legal/privacidad" class="hover:text-white">Política de Privacidad</a>
          <a href="/legal/cookies" class="hover:text-white">Política de Cookies</a>
        </div>
      </div>
    </footer>

    <CookieBanner />

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');

      btn?.addEventListener('click', () => {
        const isHidden = menu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden', !isHidden);
        iconClose?.classList.toggle('hidden', isHidden);
        btn.setAttribute('aria-expanded', String(!isHidden));
      });
    </script>
  </body>
</html>